generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  role                 String             @default("FAMILY")
  active               Boolean            @default(true)
  twoFactorEnabled     Boolean            @default(false)
  twoFactorSecret      String?
  twoFactorConfirmedAt DateTime?
  sessionVersion       Int                @default(0)
  accounts             Account[]
  sessions             Session[]
  notes                Note[]
  devices              Device[]
  eventsOwned          Event[]            @relation("EventOwner")
  eventsCreated        Event[]            @relation("EventCreator")
  pushSubscriptions    PushSubscription[]
  recoveryCodes        TwoFactorRecoveryCode[]
  authEvents           AuthEvent[]        @relation("AuthEventSubject")
  authEventsAsActor    AuthEvent[]        @relation("AuthEventActor")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("SHOPPING")
  completed Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id        String    @id @default(cuid())
  name      String
  ip        String    @unique
  mac       String?   @unique
  type      String    @default("OTHER")
  online    Boolean   @default(false)
  lastSeen  DateTime?
  notes     String?
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Event {
  id                 String             @id @default(cuid())
  title              String
  description        String?
  start              DateTime
  end                DateTime?
  allDay             Boolean            @default(false)
  reminderMinutes    Int?
  ownerId            String?
  owner              User?              @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User               @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reminderDeliveries ReminderDelivery[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([start])
}

model PushSubscription {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String             @unique @db.VarChar(1024)
  p256dh        String             @db.VarChar(255)
  auth          String             @db.VarChar(64)
  userAgent     String?            @db.VarChar(512)
  active        Boolean            @default(true)
  failureCount  Int                @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deliveries    ReminderDelivery[]

  @@index([userId, active])
  @@index([active])
}

model ReminderDelivery {
  id             String           @id @default(cuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  status         String
  attempts       Int              @default(1)
  error          String?          @db.VarChar(500)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([eventId, subscriptionId, scheduledFor])
  @@index([scheduledFor])
  @@index([createdAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("AuthEventSubject", fields: [userId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation("AuthEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model PasswordEntry {
  id          String @id @default(cuid())
  userId      String
  title       String
  url         String?
  username   String?
  passwordHash String
  notes      String?
  category   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
