# Base de datos (PostgreSQL)
# Desarrollo local: `docker compose up -d db` levanta una instancia en localhost:5433
DATABASE_URL="postgresql://casa:casa@localhost:5433/casa_os?schema=public"
# Conexion directa (sin pooler). En Neon/Vercel: la URL sin "-pooler".
# Las migraciones usan DIRECT_URL; el runtime de la app usa DATABASE_URL.
DIRECT_URL="postgresql://casa:casa@localhost:5433/casa_os?schema=public"

# NextAuth
# En produccion (Vercel) debe ser la URL publica HTTPS, p. ej.
# NEXTAUTH_URL="https://casa.tudominio.com"
NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Red local para escaneo (formato CIDR) — solo uso local
NETWORK_CIDR="192.168.1.0/24"
